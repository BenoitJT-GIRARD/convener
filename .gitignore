# MkDocs build output
site/
.cache/

# Copied app bundle (generated by deploy workflow)
docs/assets/app/

# CI output — generated by filter_public_data.py, not source
public-data/

# Notification body -- a run artefact of convener-notify-*, written only when a
# channel is configured, posted by the notify workflow, never edited.
notify-body.md

# An unsent registration confirmation (tools/convener_ops/confirmation.py),
# written only when email_transport is unconfigured or a send failed.
# Contains a participant's address and their matching code -- never
# committed, never printed; see confirmation.py's module docstring for why
# a file, and .github/workflows/registration.yml for the short-retention
# build artefact this becomes instead of a line in the job log.
unsent-confirmation.eml

# Python
__pycache__/
*.pyc
.venv/
tools/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# OS
.DS_Store
Thumbs.db

# Local credentials. Never committed: the real values live in GitHub Secrets,
# and a copy on disk is only ever for trying something out.
.env
.env.*
!.env.example

# Event private keys (tools/convener_ops/eventkeys.py never writes one to disk --
# this guards a human trying one out by hand). Only the published .pub half
# belongs in keys/events/.
*.pem
keys/events/*
!keys/events/*.pub

# Raw attendance export (tools/convener_ops/platform.py::ManualPlatform). Contains
# personal data -- display names and addresses off the meeting platform --
# and is dropped here only for one read, never committed. The room link and
# join instructions come from data/speakers.yml and data/config.yml instead
# (R-5, R-6), never from a file under this directory. This filename-specific
# pattern deliberately does not reach data/events/<id>/registrations.enc,
# which *is* committed (tools/convener_ops/registration.py) -- it holds nothing
# but per-registration ciphertext, the opposite of what this rule exists to
# keep out.
data/events/*/attendance-import.csv
