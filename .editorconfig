# What an editor has to get right before a commit is made, so that
# `.pre-commit-config.yaml`'s `trailing-whitespace` and `end-of-file-fixer`
# hooks and `.gitattributes`' `eol=lf` never have to correct it afterwards.
# Every value below is what this repository already contains; nothing here
# reformats anything.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# `tools/pyproject.toml` configures ruff, and ruff formats Python at four.
[*.py]
indent_size = 4

# A licence and a notice are reproduced texts. `NOTICE.json` is pinned by
# `tools/tests/test_notice.py` and `LICENSE` byte for byte against the Free
# Software Foundation's own file, so an editor must leave both exactly as
# they are.
[{LICENSE,NOTICE.json}]
insert_final_newline = unset
trim_trailing_whitespace = unset

# RFC 5545 requires CRLF, and `.gitattributes` marks this file binary for
# the same reason.
[*.ics]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
