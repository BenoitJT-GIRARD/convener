<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
{#
  Task 10: referencing and sharing. `pageTitle`/`pageDescription` are set by
  the content template this layout wraps -- a short fragment (e.g. an
  event's own title) rather than the full `<title>` text, composed once here
  so every consumer of it (the title tag, Open Graph, Twitter Card) states
  the identical string rather than three hand-typed near-duplicates. A page
  that sets neither (the home page) falls back to exactly what this tag read
  before this task -- no regression for the one page that needed none.

  `canonicalUrl` is this page's own real, absolute address: `page.url` is
  Eleventy's unprefixed page address, and `absoluteUrl` (site/.eleventy.js)
  turns it into this project's real published one in a single step --
  never `page.url | url`, which would still be missing the origin every
  consumer below actually needs.
#}
{% set fullTitle = (pageTitle ~ " — " ~ site.title) if pageTitle else site.title %}
{% set fullDescription = pageDescription or site.tagline %}
{% set canonicalUrl = page.url | absoluteUrl %}
<title>{{ fullTitle }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="{{ fullDescription }}">
<link rel="canonical" href="{{ canonicalUrl }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | absoluteUrl }}">
{# Fonts are self-hosted from /fonts/ — see the @font-face block in style.css.
   This head previously carried two preconnects and a stylesheet link to
   Google, which handed every visitor's address to a third party. The phase 5
   specification forbids exactly that, and this page also carries the data
   notice, so the contradiction was visible from the page itself. #}
<link rel="preload" href="{{ '/fonts/archivo-latin-standard-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/style.css' | url }}">
{#
  Open Graph / Twitter Card: acceptance criterion 6, a shared event page
  shows a correct preview. Phase 5's own task 10 left `og:image`/
  `twitter:image` out entirely rather than point either at a file that did
  not exist yet -- a link-preview bot rendering a correct text-only card
  (title, description, address) is "a fallback that is not broken",
  a broken image is not. Task 9 (phase 6) is what makes the tag safe to
  restore: `pageImage` (event.njk's own `eleventyComputed`, empty string
  when this page sets none) is this edition's real, published banner
  address, only ever set once a file actually exists there
  (`.eleventy.js::eventBannerUrl`) -- so the `{% if %}` below still chooses
  the text-only card, never a broken one, for every page (including an
  event with no banner ready yet) that carries no `pageImage`.
#}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ fullDescription }}">
<meta property="og:url" content="{{ canonicalUrl }}">
{% if pageImage %}
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:image:width" content="{{ shareImageWidth }}">
<meta property="og:image:height" content="{{ shareImageHeight }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ pageImage }}">
{% else %}
<meta name="twitter:card" content="summary">
{% endif %}
<meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ fullDescription }}">
</head>
<body>

<header class="masthead">
  {# Same continuous, cubic-Bézier ribbon as .hero__loops in index.njk,
     carried here because layout.njk is the one piece of chrome every
     public page shares -- including the ones D-18 describes that do not
     exist yet. No colour of its own: the stroke comes from .masthead__loops
     in style.css, which takes it from the generated --purple token. #}
  <svg class="masthead__loops" viewBox="0 0 400 400" fill="none" stroke-width="9" stroke-linecap="round" aria-hidden="true">
    <path d="M 320 60 C 380 60 400 130 340 150 C 280 170 270 90 330 90 C 380 90 370 180 300 200" opacity=".85"/>
    <path d="M 250 230 C 320 220 360 290 290 310 C 230 326 220 250 280 250 C 340 250 330 350 250 350" opacity=".9"/>
    <path d="M 70 270 C 30 290 50 360 110 350 C 160 342 160 280 120 280 C 80 280 60 340 120 360" opacity=".75"/>
  </svg>
  <div class="container masthead__inner">
    <a href="{{ '/' | url }}" class="masthead__brand unstyled">
      <span class="masthead__brand-mark">No.</span>
      <span class="masthead__brand-name">The Example Collective</span>
      <span class="masthead__brand-sub">Monthly Reading Group</span>
    </a>
    <a href="{{ '/app/' | url }}" class="masthead__access unstyled">Organizer access</a>
  </div>
</header>

<main>{{ content | safe }}</main>

<footer class="colophon">
  <div class="container colophon__inner">
    <p class="colophon__credit">
      <em>Run by volunteers from</em> <a href="{{ site.forum }}">The Example Collective</a> <em>&middot; A community of behavioural-science researchers.</em>
    </p>
    <nav class="colophon__nav">
      <a href="{{ '/archives/' | url }}" class="unstyled">Archives</a>
      <a href="{{ '/propose/' | url }}" class="unstyled">Propose a speaker</a>
      <a href="{{ '/data/' | url }}" class="unstyled">Data &amp; privacy</a>
      <a href="{{ site.forum }}" class="unstyled">Forum</a>
      <a href="{{ '/app/' | url }}" class="unstyled">Organizer access</a>
    </nav>
  </div>
</footer>

</body>
</html>
