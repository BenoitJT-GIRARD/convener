{
  "version": "0.2",
  "language": "en-GB",
  "dictionaryDefinitions": [
    { "name": "project-words", "path": "./project-words.txt", "addWords": true }
  ],
  "dictionaries": ["project-words"],
  "ignorePaths": [
    "node_modules/**",
    "**/package-lock.json",
    "**/uv.lock",
    "app/dist/**",
    "site/node_modules/**",
    "site/_site/**",
    "site/src/fonts/**",
    "instance/public-data/**",
    "instance/data/speakers.yml",
    "tools/**"
  ],
  "files": [
    "docs/**/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "TRADEMARK.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "services/*/README.md",
    "examples/*/README.md",
    "screenshots/README.md",
    "site/**/*.njk",
    "site/README.md",
    ".github/workflows/**"
  ]
}
