{
  "_comment": "Shared truth for the board mapping, the vote threshold and the working-day windows. Read by app/tests/governance-fixture.test.ts, app/tests/board.test.ts and tools/tests/test_governance_fixture.py. A case added here must pass in both languages.",
  "active_board_cases": [
    {
      "name": "an active member with no declared absence is eligible",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "on": "2026-01-20",
      "logins": ["ada"],
      "unavailable": [],
      "eligible": ["ada"]
    },
    {
      "name": "an inactive member leaves the board entirely, not merely the eligible set",
      "board": [
        { "login": "Anonymous", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "ada", "joined_on": "2024-01-01", "status": "inactive", "unavailable_until": "" }
      ],
      "on": "2026-01-20",
      "logins": ["Anonymous"],
      "unavailable": [],
      "eligible": ["Anonymous"]
    },
    {
      "name": "a member away until a future date is unavailable but stays on the board",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-02-01" }
      ],
      "on": "2026-01-20",
      "logins": ["ada"],
      "unavailable": ["ada"],
      "eligible": []
    },
    {
      "name": "a member whose absence has lapsed is available again the day after",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-01-19" }
      ],
      "on": "2026-01-20",
      "logins": ["ada"],
      "unavailable": [],
      "eligible": ["ada"]
    },
    {
      "name": "the boundary day itself is still an absence - unavailable_until is inclusive",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-01-20" }
      ],
      "on": "2026-01-20",
      "logins": ["ada"],
      "unavailable": ["ada"],
      "eligible": []
    },
    {
      "name": "an empty unavailable_until declares no absence at all",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "grace", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-01-20" }
      ],
      "on": "2026-01-20",
      "logins": ["ada", "grace"],
      "unavailable": ["grace"],
      "eligible": ["ada"]
    },
    {
      "name": "a malformed unavailable_until reads as an absence rather than as availability",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "not-a-date" }
      ],
      "on": "2026-01-20",
      "logins": ["ada"],
      "unavailable": ["ada"],
      "eligible": []
    },
    {
      "name": "a whole board at once: active, inactive, future, lapsed, boundary, empty, malformed",
      "board": [
        { "login": "ada", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "Anonymous", "joined_on": "2024-01-01", "status": "inactive", "unavailable_until": "" },
        { "login": "carol", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-02-01" },
        { "login": "dan", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-01-19" },
        { "login": "erin", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-01-20" },
        { "login": "grace", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "not-a-date" }
      ],
      "on": "2026-01-20",
      "logins": ["ada", "carol", "dan", "erin", "grace"],
      "unavailable": ["carol", "erin", "grace"],
      "eligible": ["ada", "dan"]
    }
  ],
  "threshold_cases": [
    { "name": "board of 3 needs 3 - the floor overrides the ratio", "eligible": 3, "expected": 3 },
    { "name": "board of 4 needs 3", "eligible": 4, "expected": 3 },
    { "name": "board of 5 needs 4", "eligible": 5, "expected": 4 },
    { "name": "board of 6 needs 4 - the handbook's own example", "eligible": 6, "expected": 4 },
    { "name": "board of 7 needs 5", "eligible": 7, "expected": 5 },
    { "name": "board of 8 needs 6", "eligible": 8, "expected": 6 },
    { "name": "board of 9 needs 6 - the handbook's other example", "eligible": 9, "expected": 6 }
  ],
  "decision_cases": [
    {
      "name": "four yes on a board of six is decided",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "yes" }
      ],
      "eligible": 6, "threshold": 4, "yes": 4, "decided": true, "suspended": false
    },
    {
      "name": "abstentions stay in the denominator, so three yes is not enough",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "abstain" },
        { "voter": "e", "value": "abstain" }, { "voter": "f", "value": "abstain" }
      ],
      "eligible": 6, "threshold": 4, "yes": 3, "decided": false, "suspended": false
    },
    {
      "name": "recusals leave the denominator, lowering the bar",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "recused" }, { "voter": "b", "value": "recused" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "yes" },
        { "voter": "e", "value": "yes" }
      ],
      "eligible": 4, "threshold": 3, "yes": 3, "decided": true, "suspended": false
    },
    {
      "name": "declared unavailability leaves the denominator too",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": ["e", "f"],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }
      ],
      "eligible": 4, "threshold": 3, "yes": 3, "decided": true, "suspended": false
    },
    {
      "name": "too few eligible members suspends the vote instead of lowering the bar",
      "board": ["a", "b", "c", "d"],
      "unavailable": ["c", "d"],
      "ballots": [{ "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" }],
      "eligible": 2, "threshold": 3, "yes": 2, "decided": false, "suspended": true
    },
    {
      "name": "the absolute floor of three yes holds even when the ratio is met",
      "board": ["a", "b", "c"],
      "unavailable": [],
      "ballots": [{ "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" }],
      "eligible": 3, "threshold": 3, "yes": 2, "decided": false, "suspended": false
    },
    {
      "name": "a repeated yes ballot from the same voter counts once, not twice",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "a", "value": "yes" },
        { "voter": "b", "value": "yes" }, { "voter": "c", "value": "yes" }
      ],
      "eligible": 6, "threshold": 4, "yes": 3, "decided": false, "suspended": false
    }
  ],
  "assign_lead_cases": [
    {
      "name": "the eligible member carrying fewer open leads is chosen",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-002", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-003", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "a tie on open leads goes to whichever member's most recent assignment is oldest",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-005", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "alice"
    },
    {
      "name": "a member who declared an absence covering today is skipped for one who did not",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-08-18" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "an inactive member is skipped even while carrying no leads",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "inactive", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "a board with no available member returns an empty string rather than throwing",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-08-18" }
      ],
      "speakers": [],
      "on": "2026-08-18",
      "expected": ""
    }
  ],
  "working_day_cases": {
    "_comment": "Working-day arithmetic, pinned across app/src/state/working-days.ts and tools/convener_ops/governance.py. Weekends are Saturday and Sunday. PUBLIC HOLIDAYS ARE DELIBERATELY NOT MODELLED: the board's members do not share one national calendar, so a holiday list right for France would be wrong for the others, and an unmodelled holiday only ever makes a window longer, which is the prudent direction. The 1 May 2026 cases below pin that as a decision rather than an oversight. The count is of the days AFTER the start day, and `elapsed` is the exact inverse of `add`.",
    "add": [
      {
        "name": "three working days from a Monday land on the Thursday",
        "from": "2026-08-17",
        "days": 3,
        "expected": "2026-08-20"
      },
      {
        "name": "three working days from a Thursday cross the weekend and land on the Tuesday",
        "from": "2026-08-20",
        "days": 3,
        "expected": "2026-08-25"
      },
      {
        "name": "three working days from a Friday land on the Wednesday",
        "from": "2026-08-21",
        "days": 3,
        "expected": "2026-08-26"
      },
      {
        "name": "three working days from a Saturday land on the same Wednesday as from the Friday",
        "from": "2026-08-22",
        "days": 3,
        "expected": "2026-08-26"
      },
      {
        "name": "three working days from a Sunday land on that Wednesday too",
        "from": "2026-08-23",
        "days": 3,
        "expected": "2026-08-26"
      },
      {
        "name": "one working day from a Friday is the Monday",
        "from": "2026-08-21",
        "days": 1,
        "expected": "2026-08-24"
      },
      {
        "name": "zero working days is the identity",
        "from": "2026-08-19",
        "days": 0,
        "expected": "2026-08-19"
      },
      {
        "name": "zero working days from a Saturday is that Saturday, not the Monday",
        "from": "2026-08-22",
        "days": 0,
        "expected": "2026-08-22"
      },
      {
        "name": "1 May 2026 is counted as an ordinary Friday - holidays are not modelled",
        "from": "2026-04-30",
        "days": 3,
        "expected": "2026-05-05"
      }
    ],
    "elapsed": [
      {
        "name": "Monday to Thursday is three working days",
        "from": "2026-08-17",
        "to": "2026-08-20",
        "expected": 3
      },
      {
        "name": "Thursday to the following Tuesday is three working days, the weekend uncounted",
        "from": "2026-08-20",
        "to": "2026-08-25",
        "expected": 3
      },
      {
        "name": "Friday to Monday is one working day",
        "from": "2026-08-21",
        "to": "2026-08-24",
        "expected": 1
      },
      {
        "name": "Saturday to Monday is one working day",
        "from": "2026-08-22",
        "to": "2026-08-24",
        "expected": 1
      },
      {
        "name": "a span inside the weekend is zero working days",
        "from": "2026-08-22",
        "to": "2026-08-23",
        "expected": 0
      },
      {
        "name": "the same day is zero working days",
        "from": "2026-08-19",
        "to": "2026-08-19",
        "expected": 0
      },
      {
        "name": "a window cannot run backwards",
        "from": "2026-08-20",
        "to": "2026-08-17",
        "expected": 0
      },
      {
        "name": "a full week is five working days",
        "from": "2026-08-17",
        "to": "2026-08-24",
        "expected": 5
      },
      {
        "name": "the 1 May 2026 span counts three working days, holidays included as ordinary days",
        "from": "2026-04-30",
        "to": "2026-05-05",
        "expected": 3
      }
    ]
  }
}
