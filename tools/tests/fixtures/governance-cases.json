{
  "_comment": "Shared truth for the vote threshold. Read by app/tests/governance-fixture.test.ts and tools/tests/test_governance_fixture.py. A case added here must pass in both languages.",
  "threshold_cases": [
    { "name": "board of 3 needs 3 - the floor overrides the ratio", "eligible": 3, "expected": 3 },
    { "name": "board of 4 needs 3", "eligible": 4, "expected": 3 },
    { "name": "board of 5 needs 4", "eligible": 5, "expected": 4 },
    { "name": "board of 6 needs 4 - the handbook's own example", "eligible": 6, "expected": 4 },
    { "name": "board of 7 needs 5", "eligible": 7, "expected": 5 },
    { "name": "board of 8 needs 6", "eligible": 8, "expected": 6 },
    { "name": "board of 9 needs 6 - the handbook's other example", "eligible": 9, "expected": 6 }
  ],
  "decision_cases": [
    {
      "name": "four yes on a board of six is decided",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "yes" }
      ],
      "eligible": 6, "threshold": 4, "yes": 4, "decided": true, "suspended": false
    },
    {
      "name": "abstentions stay in the denominator, so three yes is not enough",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "abstain" },
        { "voter": "e", "value": "abstain" }, { "voter": "f", "value": "abstain" }
      ],
      "eligible": 6, "threshold": 4, "yes": 3, "decided": false, "suspended": false
    },
    {
      "name": "recusals leave the denominator, lowering the bar",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "recused" }, { "voter": "b", "value": "recused" },
        { "voter": "c", "value": "yes" }, { "voter": "d", "value": "yes" },
        { "voter": "e", "value": "yes" }
      ],
      "eligible": 4, "threshold": 3, "yes": 3, "decided": true, "suspended": false
    },
    {
      "name": "declared unavailability leaves the denominator too",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": ["e", "f"],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" },
        { "voter": "c", "value": "yes" }
      ],
      "eligible": 4, "threshold": 3, "yes": 3, "decided": true, "suspended": false
    },
    {
      "name": "too few eligible members suspends the vote instead of lowering the bar",
      "board": ["a", "b", "c", "d"],
      "unavailable": ["c", "d"],
      "ballots": [{ "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" }],
      "eligible": 2, "threshold": 3, "yes": 2, "decided": false, "suspended": true
    },
    {
      "name": "the absolute floor of three yes holds even when the ratio is met",
      "board": ["a", "b", "c"],
      "unavailable": [],
      "ballots": [{ "voter": "a", "value": "yes" }, { "voter": "b", "value": "yes" }],
      "eligible": 3, "threshold": 3, "yes": 2, "decided": false, "suspended": false
    },
    {
      "name": "a repeated yes ballot from the same voter counts once, not twice",
      "board": ["a", "b", "c", "d", "e", "f"],
      "unavailable": [],
      "ballots": [
        { "voter": "a", "value": "yes" }, { "voter": "a", "value": "yes" },
        { "voter": "b", "value": "yes" }, { "voter": "c", "value": "yes" }
      ],
      "eligible": 6, "threshold": 4, "yes": 3, "decided": false, "suspended": false
    }
  ],
  "assign_lead_cases": [
    {
      "name": "the eligible member carrying fewer open leads is chosen",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-002", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-003", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "a tie on open leads goes to whichever member's most recent assignment is oldest",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "alice" },
        { "id": "spk-005", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "alice"
    },
    {
      "name": "a member who declared an absence covering today is skipped for one who did not",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-08-18" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "an inactive member is skipped even while carrying no leads",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "inactive", "unavailable_until": "" },
        { "login": "bob", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "" }
      ],
      "speakers": [
        { "id": "spk-001", "status": "lead", "assigned_to": "bob" }
      ],
      "on": "2026-08-18",
      "expected": "bob"
    },
    {
      "name": "a board with no available member returns an empty string rather than throwing",
      "board": [
        { "login": "alice", "joined_on": "2024-01-01", "status": "active", "unavailable_until": "2026-08-18" }
      ],
      "speakers": [],
      "on": "2026-08-18",
      "expected": ""
    }
  ]
}
